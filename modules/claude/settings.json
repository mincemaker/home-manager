{
  "agentPushNotifEnabled": true,
  "attribution": {
    "sessionUrl": false
  },
  "autoUpdatesChannel": "stable",
  "editorMode": "normal",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "pyright-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "_pixtuoid": true,
        "hooks": [
          {
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PermissionRequest": [
      {
        "_pixtuoid": true,
        "hooks": [
          {
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PostToolUse": [
      {
        "_pixtuoid": true,
        "hooks": [
          {
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'",
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "open-plan-mo",
            "if": "Edit(*/.claude/plans/*)",
            "type": "command"
          }
        ],
        "matcher": "Edit"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "open-plan-mo",
            "if": "Write(*/.claude/plans/*)",
            "type": "command"
          }
        ],
        "matcher": "Write"
      },
      {
        "hooks": [
          {
            "command": "open-plan-mo",
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "PreToolUse": [
      {
        "_pixtuoid": true,
        "hooks": [
          {
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'",
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "command": "deepwiki-guard",
            "type": "command"
          }
        ],
        "matcher": "mcp__deepwiki__.*"
      },
      {
        "hooks": [
          {
            "command": "guard-and-guide",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionEnd": [
      {
        "_pixtuoid": true,
        "hooks": [
          {
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SessionStart": [
      {
        "_pixtuoid": true,
        "hooks": [
          {
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SubagentStart": [
      {
        "_pixtuoid": true,
        "hooks": [
          {
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "SubagentStop": [
      {
        "_pixtuoid": true,
        "hooks": [
          {
            "command": "PIXTUOID_SOURCE=claude-code 'pixtuoid-hook'",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ]
  },
  "language": "Japanese",
  "permissions": {
    "allow": [
      "Bash(qs:*)",
      "Bash(systemctl --user show-environment:*)",
      "WebFetch(domain:docs.noctalia.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:quickshell.org)",
      "WebFetch(domain:quickshell.outfoxxed.me)",
      "WebSearch"
    ],
    "ask": [
      "Bash(curl:*)",
      "Bash(git config:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git rm:*)",
      "Bash(git switch:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(* .env*)",
      "Bash(* ~/.aws/*)",
      "Bash(* ~/.config/gh/*)",
      "Bash(* ~/.git-credentials)",
      "Bash(* ~/.netrc)",
      "Bash(* ~/.npmrc)",
      "Bash(* ~/.ssh/*)",
      "Bash(chmod 777:*)",
      "Bash(do)",
      "Bash(find * -delete*)",
      "Bash(for)",
      "Bash(gh repo delete:*)",
      "Bash(mongod:*)",
      "Bash(mysql:*)",
      "Bash(nc *)",
      "Bash(nc:*)",
      "Bash(ncat *)",
      "Bash(open *)",
      "Bash(osascript *)",
      "Bash(pbcopy *)",
      "Bash(pbpaste *)",
      "Bash(psql:*)",
      "Bash(push:*)",
      "Bash(pushf:*)",
      "Bash(rmdir *)",
      "Bash(rsync * --delete*)",
      "Bash(scp *)",
      "Bash(security *)",
      "Bash(shred *)",
      "Bash(ssh *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Bash(sudo:*)",
      "Bash(telnet *)",
      "Bash(unlink *)",
      "Bash(wget *)",
      "Bash(wget:*)",
      "Edit(**/*.env*)",
      "Edit(**/*key)",
      "Edit(**/*secrets*)",
      "Edit(**/*token*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(/secrets/**)",
      "Edit(id_ed25519)",
      "Edit(id_rsa)",
      "Read(**/*.env*)",
      "Read(**/*key)",
      "Read(**/*secrets*)",
      "Read(**/*token*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(/secrets/**)",
      "Read(id_ed25519)",
      "Read(id_rsa)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.ssh/**)",
      "mcp__supabase__execute_sql"
    ]
  },
  "statusLine": {
    "command": "~/.claude/statusline.ts",
    "type": "command"
  },
  "verbose": true
}
